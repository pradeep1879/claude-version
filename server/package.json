{
  "name": "server",
  "type": "module",
  "private": true,
  "main": "dist/server.js",
  "bin": {
    "orbital": "./src/cli/main.ts"
  },
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "build": "bun build ./src/server.ts ./src/cli/main.ts --outdir dist --target bun",
    "start": "bun run dist/server.js",
    "cli": "bun run src/cli/main.ts",
    "typecheck": "node ./node_modules/typescript/bin/tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "prisma": "^7.4.2",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.43",
    "@clack/prompts": "^1.1.0",
    "@prisma/adapter-pg": "^7.4.2",
    "@prisma/client": "^7.4.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "ai": "^6.0.116",
    "better-auth": "^1.5.4",
    "boxen": "^8.0.1",
    "chalk": "^5.6.2",
    "cli-highlight": "^2.1.11",
    "commander": "^14.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "figlet": "^1.10.0",
    "marked": "^17.0.4",
    "marked-terminal": "^7.3.0",
    "open": "^11.0.0",
    "pg": "^8.20.0",
    "yocto-spinner": "^1.1.0",
    "zod": "^4.3.6"
  }
}
